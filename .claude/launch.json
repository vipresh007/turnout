{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:api"
      ],
      "port": 4000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "web",
        "-w",
        "@turnout/mobile"
      ],
      "port": 8081
    },
    {
      "name": "web-local",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "EXPO_PUBLIC_ENTRA_AUTHORITY=",
        "EXPO_PUBLIC_API_URL=http://localhost:4000",
        "EXPO_PUBLIC_WEB_URL=http://localhost:8082",
        "npx",
        "expo",
        "start",
        "--web",
        "--port",
        "8082"
      ],
      "cwd": "apps/mobile",
      "port": 8082
    },
    {
      "name": "mock",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8096",
        "-d",
        "/private/tmp/claude-502/-Users-vipre-Code-turnout/e5568aab-4cfb-443c-aff8-c04b9b04953d/scratchpad/mock"
      ],
      "port": 8096
    }
  ]
}