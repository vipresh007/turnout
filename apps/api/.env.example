PORT=4000
# Leave unset to use in-process PGlite. Set PGLITE_DIR to persist it between restarts.
# DATABASE_URL=postgres://user:pass@host:5432/turnout
PGLITE_DIR=.data/pglite
# Accept the x-dev-user header as organizer identity. Never enable this in a deployed environment.
ALLOW_DEV_AUTH=true
# Azure AI Foundry for the one-sentence setup. Without these it uses the rule-based parser.
# AZURE_AI_ENDPOINT=https://<resource>.services.ai.azure.com
# AZURE_AI_API_KEY=
# AZURE_AI_DEPLOYMENT=gpt-5-mini
