PORT=4000
# Leave unset to use in-process PGlite. Set PGLITE_DIR to persist it between restarts.
# DATABASE_URL=postgres://user:pass@host:5432/turnout
PGLITE_DIR=.data/pglite
# Accept the x-dev-user header as organizer identity. Local development only: never set this in Azure.
ALLOW_DEV_AUTH=true
# Microsoft Entra External ID (printed by infra/setup-entra.sh). When set, Bearer tokens are verified.
# ENTRA_AUTHORITY=https://turnoutapp.ciamlogin.com/<tenant-id>/v2.0
# ENTRA_API_CLIENT_ID=
# Azure AI Foundry / Azure OpenAI for the one-sentence setup. Without these it uses the rule-based parser.
# AZURE_AI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_AI_API_KEY=
# AZURE_AI_DEPLOYMENT=gpt-4.1-mini
# Live updates. Without it the app polls.
# WEB_PUBSUB_CONNECTION_STRING=
# APPLICATIONINSIGHTS_CONNECTION_STRING=
