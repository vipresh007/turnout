{
  "expo": {
    "name": "Turnout",
    "slug": "turnout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ca.dataeaver.turnout",
      "associatedDomains": [
        "applinks:turnout.dataeaver.ca",
        "applinks:turnout-test.dataeaver.ca"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "appleTeamId": "253QMGHP88"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#16A34A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ca.dataeaver.turnout",
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "ca.dataeaver.turnout",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#16A34A"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Turnout uses your contacts only when you pick players to add to your group."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#0E1113"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "117f314d-0932-4d16-a1c4-f037cca7c085"
      }
    },
    "owner": "vipresh1993"
  }
}
