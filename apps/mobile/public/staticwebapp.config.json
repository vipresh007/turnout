{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_expo/*", "/assets/*", "*.{png,jpg,jpeg,gif,svg,ico,webp,js,css,json,ttf,woff,woff2,map}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Frame-Options": "DENY",
    "Permissions-Policy": "camera=(), microphone=(), geolocation=()"
  },
  "routes": [
    { "route": "/_expo/*", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } }
  ]
}
